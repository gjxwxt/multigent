package main

import (
	"database/sql"
	"embed"
	"encoding/json"
	"errors"
	"io/fs"
	"log"
	"net/http"
	"os"
	"strings"

	"example.com/multigent-fullstack/store"

	_ "modernc.org/sqlite"
)

// webui/dist 由 `make build`（或 CI build:backend）在编译前写入：前端产物
// 内嵌进单一二进制，部署只交付一个容器（deploy/Dockerfile）。
// dist/placeholder.txt 保证 fresh clone（未构建前端）时 go vet/test 仍可编译。
//
//go:embed all:webui/dist
var webuiDist embed.FS

// appDB is the process-wide handle. Open/resolve happens in main; handlers
// only read. Seed commands open their own short-lived connections.
var appDB *sql.DB

func main() {
	port := os.Getenv("PORT")
	if port == "" {
		port = "8080"
	}
	db, dbPath, err := store.Open()
	if err != nil {
		log.Fatalf("open app db: %v", err)
	}
	appDB = db
	if err := store.Migrate(db, "migrations"); err != nil {
		log.Fatalf("migrate app db (%s): %v", dbPath, err)
	}
	// A freshly created empty database still serves the API; the preview
	// sandbox provisions seeded data before startup (fixture contract), so
	// this baseline check is informational only.
	if _, ok, _ := store.GetMeta(db, "fixture_version"); !ok {
		log.Printf("app db %s has no fixture baseline yet (run: npm run db:seed:baseline)", dbPath)
	}
	log.Printf("api listening on :%s (db: %s)", port, dbPath)
	if err := http.ListenAndServe(":"+port, newHandler()); err != nil {
		log.Fatal(err)
	}
}

func newHandler() http.Handler {
	mux := http.NewServeMux()
	mux.HandleFunc("GET /api/health", func(w http.ResponseWriter, _ *http.Request) {
		w.Header().Set("Content-Type", "application/json")
		dbStatus := "unavailable"
		if appDB != nil {
			if err := appDB.Ping(); err == nil {
				dbStatus = "ok"
			}
		}
		_ = json.NewEncoder(w).Encode(map[string]string{"status": "ok", "service": "api", "db": dbStatus})
	})
	mux.HandleFunc("GET /api/hello", func(w http.ResponseWriter, _ *http.Request) {
		w.Header().Set("Content-Type", "application/json")
		_ = json.NewEncoder(w).Encode(map[string]string{"message": "hello from Go"})
	})
	mux.HandleFunc("GET /api/customers", func(w http.ResponseWriter, _ *http.Request) {
		writeJSONList(w, `SELECT id, name, email, tier, created_at FROM customers ORDER BY id`)
	})
	mux.HandleFunc("GET /api/orders", func(w http.ResponseWriter, r *http.Request) {
		limit := 50
		if v := strings.TrimSpace(r.URL.Query().Get("limit")); v != "" && v != "0" {
			if n, ok := positiveInt(v); ok && n <= 500 {
				limit = n
			}
		}
		writeJSONList(w, `SELECT id, customer_id, title, amount_cents, status, note, created_at
FROM orders ORDER BY id DESC LIMIT `+itoa(limit))
	})
	mux.HandleFunc("/api/", func(w http.ResponseWriter, _ *http.Request) {
		w.Header().Set("Content-Type", "application/json")
		w.WriteHeader(http.StatusNotFound)
		_ = json.NewEncoder(w).Encode(map[string]string{"error": "not found"})
	})
	mux.Handle("/", spaHandler())
	return mux
}

func positiveInt(raw string) (int, bool) {
	n := 0
	for _, c := range raw {
		if c < '0' || c > '9' {
			return 0, false
		}
		n = n*10 + int(c-'0')
		if n > 1_000_000 {
			return 0, false
		}
	}
	return n, n > 0
}

func itoa(n int) string {
	if n == 0 {
		return "0"
	}
	var buf [20]byte
	i := len(buf)
	for n > 0 {
		i--
		buf[i] = byte('0' + n%10)
		n /= 10
	}
	return string(buf[i:])
}

// writeJSONList runs a read-only query and streams the rows as a JSON array.
// A missing table (empty db) yields [] rather than a 500: the preview must
// render even before the fixture baseline is provisioned.
func writeJSONList(w http.ResponseWriter, query string) {
	w.Header().Set("Content-Type", "application/json")
	if appDB == nil {
		_, _ = w.Write([]byte("[]"))
		return
	}
	rows, err := appDB.Query(query)
	if err != nil {
		if errors.Is(err, sql.ErrNoRows) || strings.Contains(err.Error(), "no such table") {
			_, _ = w.Write([]byte("[]"))
			return
		}
		w.WriteHeader(http.StatusInternalServerError)
		_ = json.NewEncoder(w).Encode(map[string]string{"error": "query failed"})
		return
	}
	defer rows.Close()
	cols, err := rows.Columns()
	if err != nil {
		w.WriteHeader(http.StatusInternalServerError)
		_ = json.NewEncoder(w).Encode(map[string]string{"error": "query failed"})
		return
	}
	type row = map[string]any
	out := make([]row, 0, 16)
	vals := make([]any, len(cols))
	ptrs := make([]any, len(cols))
	for i := range vals {
		ptrs[i] = &vals[i]
	}
	for rows.Next() {
		if err := rows.Scan(ptrs...); err != nil {
			w.WriteHeader(http.StatusInternalServerError)
			_ = json.NewEncoder(w).Encode(map[string]string{"error": "scan failed"})
			return
		}
		r := make(row, len(cols))
		for i, c := range cols {
			v := vals[i]
			if b, ok := v.([]byte); ok {
				v = string(b)
			}
			r[c] = v
		}
		out = append(out, r)
	}
	if err := rows.Err(); err != nil {
		w.WriteHeader(http.StatusInternalServerError)
		_ = json.NewEncoder(w).Encode(map[string]string{"error": "rows failed"})
		return
	}
	_ = json.NewEncoder(w).Encode(out)
}

// spaHandler 服务内嵌前端产物：命中文件直接返回，未命中的路径回
// index.html（前端路由接管）；前端尚未构建时返回 503 并给出指引。
func spaHandler() http.Handler {
	dist, err := fs.Sub(webuiDist, "webui/dist")
	if err != nil {
		panic("embedded webui/dist unavailable: " + err.Error())
	}
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if r.Method != http.MethodGet && r.Method != http.MethodHead {
			http.Error(w, "method not allowed", http.StatusMethodNotAllowed)
			return
		}
		name := strings.TrimPrefix(r.URL.Path, "/")
		if name == "" {
			name = "index.html"
		}
		if _, statErr := fs.Stat(dist, name); statErr != nil {
			if _, statErr := fs.Stat(dist, "index.html"); statErr != nil {
				http.Error(w, "web assets not built; run `make build`", http.StatusServiceUnavailable)
				return
			}
			name = "index.html"
		}
		http.ServeFileFS(w, r, dist, name)
	})
}
